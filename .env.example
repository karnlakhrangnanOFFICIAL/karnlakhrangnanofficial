# Football-Data.org API Token
# Used by /api/football-data/* to fetch real-time Premier League matches and standings
# Get your free token at: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=fb73ad1df2194fdab3fe56614d1a953e
FOOTBALL_DATA_API_KEY=fb73ad1df2194fdab3fe56614d1a953e

# Google Gemini API Key (Server-side AI features)
# Used for server-side AI analysis and automated translations
GEMINI_API_KEY=

# Node Environment
NODE_ENV=production

