{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "data/**",
      "maxDuration": 15
    },
    "api/*.js": {
      "includeFiles": "data/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/football-data/teams/61/matches", "destination": "/api/football-data/teams/61/matches.js" },
    { "source": "/api/football-data/:path*", "destination": "/api/football-data/[...path].js" },
    { "source": "/api/news", "destination": "/api/news.js" },
    { "source": "/api/pl-match", "destination": "/api/pl-match.js" },
    { "source": "/api/efl-match", "destination": "/api/efl-match.js" },
    { "source": "/api/epl-standings", "destination": "/api/epl-standings.js" },
    { "source": "/api/wsl-standings", "destination": "/api/wsl-standings.js" },
    { "source": "/api/uwcl-standings", "destination": "/api/uwcl-standings.js" },
    { "source": "/trophy", "destination": "/trophy.html" },
    { "source": "/the-story-blue", "destination": "/the-story-blue.html" },
    { "source": "/icons", "destination": "/icons.html" },
    { "source": "/trophy/:id", "destination": "/trophy/:id.html" },
    { "source": "/the-story-blue/:chapter", "destination": "/the-story-blue/:chapter.html" },
    { "source": "/icon/:name", "destination": "/icon/:name.html" }
  ]
}
